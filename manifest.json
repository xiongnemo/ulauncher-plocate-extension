{
    "required_api_version": "2",
    "name": "Fast File Finder",
    "description": "Find files instantly using plocate. Supports quoted phrases, ext:, path:, and regex:.",
    "developer_name": "Nemo",
    "icon": "images/icon.png",
    "options": {
        "query_debounce": 0.3
    },
    "preferences": [
        {
            "id": "keyword",
            "type": "keyword",
            "name": "Find files",
            "description": "Keyword to activate this plugin",
            "default_value": "f"
        },
        {
            "id": "limit",
            "type": "input",
            "name": "Max results",
            "description": "Maximum number of results to show",
            "default_value": "10"
        },
        {
            "id": "case_sensitive",
            "type": "select",
            "name": "Case sensitivity",
            "description": "Case sensitivity for plocate search",
            "default_value": "false",
            "options": [
                {
                    "text": "Ignore case",
                    "value": "false"
                },
                {
                    "text": "Case sensitive",
                    "value": "true"
                }
            ]
        }
    ]
}
